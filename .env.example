# --- LLM provider: gemini | openai (optional; auto-detect from API keys) ---
LLM_PROVIDER=gemini

# Google Gemini (recommended) — key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 推荐 gemini-2.5-flash（教练 JSON 更稳）。2.5-pro 易触发 finish_reason=length
GEMINI_MODEL=gemini-2.5-flash
# OpenAI-compatible endpoint (default, usually no need to change)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# OpenAI (alternative)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Clash 等：让 Node 走代理（VPN 开着也常需要这一项）
GEMINI_HTTPS_PROXY=http://127.0.0.1:7890

# 无法直连 Google 时也可改用 OpenRouter：
# https://openrouter.ai/keys
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-pro

# Set to "true" to force local mock (no API calls)
LLM_MOCK=false

# Append coach runtime v2.3 shadow traces to .coach-traces/ (does not change coach output)
COACH_RUNTIME_SHADOW=false
# Enforce arbitrated plan on coach output after LLM (default true; set false to legacy LLM-only)
COACH_RUNTIME_PLAN_ENFORCE=true
# COACH_RUNTIME_MODE=full|deterministic|legacy
