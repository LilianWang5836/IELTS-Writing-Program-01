# --- LLM provider: gemini | openai (optional; auto-detect from API keys) ---
LLM_PROVIDER=gemini

# Google Gemini (recommended) — key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 推理更强: gemini-2.5-pro | 均衡: gemini-2.5-flash | 更快: gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash
# OpenAI-compatible endpoint (default, usually no need to change)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# OpenAI (alternative)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Clash 等：让 Node 走代理（VPN 开着也常需要这一项）
GEMINI_HTTPS_PROXY=http://127.0.0.1:7890

# 无法直连 Google 时也可改用 OpenRouter：
# https://openrouter.ai/keys
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-pro

# Set to "true" to force local mock (no API calls)
LLM_MOCK=false
